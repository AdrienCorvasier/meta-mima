# Serial device connected to the B-G431B-ESC1 (ST-Link VCP, or a direct
# UART if the board is wired straight to the host's UART pins instead).
ESCD_SERIAL_DEVICE=/dev/ttyACM0

# Character device created by the esc_sysfs kernel module.
ESCD_CTL_DEVICE=/dev/esc0

# UART baud rate configured by the mima-esc firmware
# (thirdparty/mima-esc/Src/main.c: huart2.Init.BaudRate).
ESCD_BAUD_RATE=1843200
